# ============================================================
# LegacyGraph-MCP Configuration
# ============================================================

# The mode defines how the MCP server handles state and networking.
# "cloud" -> Uses HTTP transport, restricted file ingestion (2k limit), requires HF_BUCKET_URL.
# "local" -> Uses stdio/direct invocation, boundless file ingestion, no persistent bucket needed.
MCP_MODE=cloud

# (Cloud only) Storage Bucket URL used to synchronize parsed analysis states 
# across ephemeral restarts. Use the "hf://" protocol.
# Example: hf://datasets/YourHuggingFaceUser/YourBucketId
HF_BUCKET_URL=

# Hugging Face Access Token. Required for cloud-sync via HuggingFace-CLI.
# This should be a robust "Write" capable token provided by HF Spaces.
HF_TOKEN=

# Port for the Streamable HTTP Transport
# Defaults to 8000. In HF Spaces, they pass $PORT automatically.
PORT=8000

# (Optional) Restrict concurrent worker cores to prevent out-of-memory errors on small VMs
# LEGACYMCP_MAX_WORKERS=2

# ============================================================
# Feedback & Feature Requests (send_feedback tool)
# ============================================================

# (Optional) Incoming Webhook URL (e.g. Discord, Slack, Zapier, or generic JSON HTTP endpoint)
# FEEDBACK_WEBHOOK_URL=https://discord.com/api/webhooks/...

# (Optional) GitHub Personal Access Token for filing issues directly
# GITHUB_TOKEN=ghp_...

# (Optional) GitHub repository target for feedback issues (default: rohit-yadav34/LegacyGraph-MCP)
# GITHUB_REPO=rohit-yadav34/LegacyGraph-MCP

# (Optional) Path for local feedback JSONL audit trail (default: data/feedback.jsonl)
# FEEDBACK_LOCAL_PATH=data/feedback.jsonl

